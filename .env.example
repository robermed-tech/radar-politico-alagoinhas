# ── Cliente ───────────────────────────────────────────────────────────────────
# Aponta para o arquivo JSON com os dados do cliente (perfis, keywords, etc.)
# Copie clientes/template.json, preencha e ajuste este caminho.
CLIENT_CONFIG=clientes/alagoinhas.json

# ── Apify ─────────────────────────────────────────────────────────────────────
APIFY_API_TOKEN=your_apify_api_token_here
APIFY_DATASET_ID=your_dataset_id_here

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Google Sheets ─────────────────────────────────────────────────────────────
# Caminho para o arquivo JSON da service account do Google
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_NAME=Radar
