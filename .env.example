# ── Cliente ───────────────────────────────────────────────────────────────────
# Aponta para o arquivo JSON com os dados do cliente (perfis, keywords, etc.)
# Copie clientes/template.json, preencha e ajuste este caminho.
CLIENT_CONFIG=clientes/alagoinhas.json

# ── Coletor Instagram ─────────────────────────────────────────────────────────
# OPÇÃO 1 (recomendada): Instagrapi + Proxy Webshare
# Crie uma conta Instagram dedicada ao monitoramento (não use a pessoal).
# O sistema salva a sessão em ig_session.json para evitar login repetido.
IG_USERNAME=seu_usuario_instagram
IG_PASSWORD=sua_senha_instagram
IG_SESSION_FILE=ig_session.json

# Proxy Webshare (fortemente recomendado — evita bloqueio de IP)
# Acesse: https://webshare.io → Dashboard → Proxy List → Export → formato HTTP
# Formato: http://USUARIO:SENHA@proxy.webshare.io:80
IG_PROXY=http://USUARIO:SENHA@proxy.webshare.io:80

# OPÇÃO 2 (paga): Apify — usado automaticamente se IG_USERNAME não estiver definido
APIFY_API_TOKEN=your_apify_api_token_here
APIFY_DATASET_ID=your_dataset_id_here

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Teto MENSAL de gasto com o modelo, em USD. Não é limite técnico (a API não
# corta em valor nenhum): é a referência da barra de consumo no painel
# (Configuração > Monitor de coleta) e do alerta de WhatsApp a partir de 80%.
# Sem a variável, vale 25.
ANTHROPIC_BUDGET_USD=25

# ── Google Sheets (mantido para compatibilidade — será opcional no Dia 5) ─────
# Caminho para o arquivo JSON da service account do Google
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_NAME=Radar

# ── Banco Central — Supabase (Dias 1-5 do plano estratégico) ──────────────────
# Crie em: https://app.supabase.com → New Project
# Depois execute schema.sql no SQL Editor do Supabase.
#
# SUPABASE_URL  → Supabase > Settings > API > Project URL
# SUPABASE_KEY  → Supabase > Settings > API > service_role key (secret)
#
# Se estas variáveis estiverem ausentes, o sistema continua funcionando
# normalmente usando apenas Google Sheets (modo de compatibilidade).
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua_service_role_key_aqui
